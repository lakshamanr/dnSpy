<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product
        Id="*"
        Name="dnSpy"
        Language="1033"
        Version="$(var.ProductVersion)"
        Manufacturer="dnSpy"
        UpgradeCode="$(var.UpgradeCode)">
        <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Description="dnSpy - .NET debugger and decompiler" />

        <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallInitialize" />
        <MediaTemplate EmbedCab="yes" />

        <!-- Self-contained .NET 5 app: no .NET prerequisite, so no LaunchCondition. -->

        <Icon Id="dnSpyIcon" SourceFile="$(var.IconFile)" />
        <Property Id="ARPPRODUCTICON" Value="dnSpyIcon" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/lakshamanr/dnSpy" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="$(var.ProgramFilesId)">
                <Directory Id="INSTALLFOLDER" Name="dnSpy" />
            </Directory>
        </Directory>

        <!-- The whole publish dir (dnSpy.exe, dnSpy.Console.exe and the bin\ payload)
             is harvested by heat into Payload.wxs. That fragment defines the
             'Payload' component group, which the feature below references. -->

        <Feature Id="MainFeature" Title="dnSpy" Level="1">
            <ComponentGroupRef Id="Payload" />
        </Feature>

        <UIRef Id="WixUI_InstallDir" />
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    </Product>
</Wix>
