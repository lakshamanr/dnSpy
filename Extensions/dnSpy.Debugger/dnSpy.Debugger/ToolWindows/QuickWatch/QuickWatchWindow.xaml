<winlocal:WindowBase x:Class="dnSpy.Debugger.ToolWindows.QuickWatch.QuickWatchWindow"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:winlocal="clr-namespace:dnSpy.Contracts.Controls;assembly=dnSpy.Contracts.DnSpy"
             xmlns:img="clr-namespace:dnSpy.Contracts.Images;assembly=dnSpy.Contracts.DnSpy"
             Title="Quick Watch"
             Width="480"
             SizeToContent="Height"
             MinWidth="360"
             Style="{StaticResource DialogWindowStyle}"
             WindowStartupLocation="CenterOwner">
    <Grid img:DsImage.BackgroundBrush="{DynamicResource DialogWindowBackground}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Expression row -->
        <TextBlock Grid.Row="0" Text="Expression:" Margin="0,0,0,4" FontWeight="SemiBold"/>
        <TextBox Grid.Row="1" x:Name="ExpressionTextBox" Margin="0,0,0,8" Padding="4,3"
                 VerticalContentAlignment="Center"/>

        <!-- Value row -->
        <TextBlock Grid.Row="2" Text="Value:" Margin="0,0,0,4" FontWeight="SemiBold"/>
        <TextBox Grid.Row="3" x:Name="ValueTextBox" IsReadOnly="True" Margin="0,0,0,8" Padding="4,3"
                 TextWrapping="Wrap" MinHeight="60" MaxHeight="150"
                 VerticalScrollBarVisibility="Auto" AcceptsReturn="False"
                 FontFamily="Consolas, Courier New, monospace"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="AddToWatchButton" Content="_Add to Watch" MinWidth="110" Margin="0,0,8,0"
                    Padding="8,4" Click="AddToWatch_Click"/>
            <Button Content="_Close" MinWidth="75" IsCancel="True" Padding="8,4"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</winlocal:WindowBase>
